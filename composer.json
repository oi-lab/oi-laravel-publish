{
    "name": "oi-lab/oi-laravel-publish",
    "description": "Recursive CMS pages with ordered blocks, code-defined templates, spatie/laravel-data props and attachments",
    "type": "library",
    "keywords": [
        "laravel",
        "cms",
        "publish",
        "pages",
        "blocks",
        "content",
        "oi-lab"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "OI Lab",
            "email": "olivier@olacombe.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "oi-lab/oi-laravel-attachments": "^1.0",
        "spatie/laravel-data": "^4.0"
    },
    "suggest": {
        "oi-lab/oi-laravel-settings": "Recommended settings backend: scoped, typed values automatically wired for publish settings."
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "OiLab\\OiLaravelPublish\\": "src/",
            "OiLab\\OiLaravelPublish\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OiLab\\OiLaravelPublish\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OiLab\\OiLaravelPublish\\OiLaravelPublishServiceProvider"
            ]
        },
        "oi-lab": {
            "skills": [
                {
                    "name": "oilab-laravel-publish",
                    "description": "Recursive CMS pages with ordered, templated blocks and attachments",
                    "path": "resources/stubs/ai-skill.md",
                    "rules": "resources/stubs/claude-rules.md",
                    "section": "oi-lab/oi-laravel-publish rules"
                }
            ]
        }
    },
    "scripts": {
        "sync-ai-skills": [
            "@php scripts/sync-ai-skills.php"
        ],
        "post-autoload-dump": [
            "@php scripts/sync-ai-skills.php"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../oi-laravel-attachments",
            "options": {
                "symlink": true,
                "versions": {
                    "oi-lab/oi-laravel-attachments": "1.0.3"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
